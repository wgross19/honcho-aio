#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/honcho-aio-lib.sh

load_runtime
wait_postgres
wait_redis
ensure_postgres

# Provision the schema (Alembic migrations) before serving, matching upstream.
# Run as honcho, then hand off to the FastAPI server. cwd must be /opt/honcho
# so `import src.*` resolves.
cd /opt/honcho
gosu honcho env HOME=/var/lib/honcho \
  /opt/honcho/.venv/bin/python /opt/honcho/scripts/provision_db.py

exec gosu honcho env HOME=/var/lib/honcho /usr/local/bin/honcho-api
