#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/honcho-aio-lib.sh

load_runtime
wait_postgres
wait_redis
ensure_postgres

# Provision the schema (Alembic migrations) before serving, matching upstream.
# Run as honcho, then hand off to the FastAPI server. cwd must be /opt/honcho
# so `import src.*` resolves.
cd /opt/honcho
gosu honcho env HOME=/var/lib/honcho \
  /opt/honcho/.venv/bin/python /opt/honcho/scripts/provision_db.py

# Reconcile pgvector column dimensions with EMBEDDING_VECTOR_DIMENSIONS
# Alembic creates default vector(1536); configure_embeddings.py ALTERs to
# match the configured value. Idempotent — no-op when dims already match.
gosu honcho env HOME=/var/lib/honcho \
  /opt/honcho/.venv/bin/python /opt/honcho/scripts/configure_embeddings.py --yes

if [[ -n "${HONCHO_LOG_FILE-}" ]]; then
	mkdir -p "$(dirname "${HONCHO_LOG_FILE}")"
	touch "${HONCHO_LOG_FILE}"
	chown honcho:users "${HONCHO_LOG_FILE}" 2>/dev/null || true
	exec gosu honcho env HOME=/var/lib/honcho /usr/local/bin/honcho-api 2>&1 | tee -a "${HONCHO_LOG_FILE}"
else
	exec gosu honcho env HOME=/var/lib/honcho /usr/local/bin/honcho-api
fi
