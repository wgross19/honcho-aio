#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

# shellcheck disable=SC1091
. /usr/local/lib/honcho-aio-lib.sh

load_runtime
wait_postgres

# The deriver needs the same DB role + vector extension the API provisioned.
ensure_postgres

# cwd must be /opt/honcho so `import src.deriver` resolves.
cd /opt/honcho
exec gosu honcho env HOME=/var/lib/honcho \
  /opt/honcho/.venv/bin/python -m src.deriver
